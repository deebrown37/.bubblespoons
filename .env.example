PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:3000
DB_PATH=./data/app.sqlite
# Set an existing registered account as moderator. Never grant this in the browser.
ADMIN_EMAIL=
# Public HTTPS deployment must use NODE_ENV=production and a matching HTTPS APP_ORIGIN.
NODE_ENV=development

# Optional services. Start with provider TEST credentials; never commit real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKR_SECRET_KEY=
# 32 random bytes as 64 hexadecimal characters. Back up securely, separate from DB.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PRIVATE_DATA_KEY=
